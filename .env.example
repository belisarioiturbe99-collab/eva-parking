# Configuración del Servidor Flask
FLASK_ENV=development
FLASK_HOST=0.0.0.0
FLASK_PORT=5050
SECRET_KEY=reemplazar_por_clave_secreta_aleatoria

# Conexión a Base de Datos MySQL (XAMPP local o MySQL en la nube como Aiven)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=tu_usuario_mysql
DB_PASSWORD=
DB_NAME=eva_parking

# Opciones para Despliegue en la Nube (Render + Aiven / TiDB / Railway)
# DB_SSL=auto          # 'auto' activa TLS automáticamente si DB_HOST no es local
# AUTO_INIT_DB=true    # Si es 'true', crea tablas y datos iniciales automáticamente si la BD está vacía
